+    def wait(self, predicate, timeout=8):
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            self.app.update()
+            if predicate():
+                return
+            time.sleep(0.01)
+        self.fail("UI did not complete its background operation")
